<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Birthday Invitation</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital@1&family=Cormorant+Garamond:wght@400;600&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    min-height: 100vh;
    overflow: hidden;
    font-family: 'Cormorant Garamond', serif;
    background: #1a0000;
  }

  /* ─────────────────────────────────────────
     PAGES
  ───────────────────────────────────────── */
  .page {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s ease;
    z-index: 1;
  }

  .page.active {
    opacity: 1;
    pointer-events: all;
    z-index: 5;
  }

  /* ─────────────────────────────────────────
     PAGE 1 — ENVELOPE
  ───────────────────────────────────────── */
  #page1 {
    background: #f5ede0;
  }

  .envelope-wrap {
    position: relative;
    width: min(88vw, 400px);
    cursor: pointer;
  }

  .envelope-img {
    width: 100%;
    display: block;
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    transition: transform 0.3s ease;
  }

  .envelope-wrap:hover .envelope-img {
    transform: scale(1.02);
  }

  /* Flap that flips open */
  .flap {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 50%;
    overflow: hidden;
    border-radius: 12px 12px 0 0;
    transform-origin: top center;
    transform-style: preserve-3d;
    transition: transform 1s cubic-bezier(0.4,0,0.2,1);
  }

  .flap img {
    width: 100%;
    position: absolute;
    top: 0; left: 0;
  }

  /* Card peeking */
  .card-peek {
    position: absolute;
    bottom: 4%; left: 50%;
    transform: translateX(-50%) translateY(0);
    width: 86%; height: 50%;
    background: linear-gradient(135deg, #8b0000, #4a0000);
    border-radius: 10px;
    opacity: 0;
    z-index: -1;
    transition: all 0.9s ease 0.5s;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #c9a96e;
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: clamp(15px,4vw,20px);
    box-shadow: 0 -10px 30px rgba(0,0,0,0.3);
  }

  .envelope-wrap.opening .flap {
    transform: rotateX(-175deg);
  }

  .envelope-wrap.opening .card-peek {
    opacity: 1;
    transform: translateX(-50%) translateY(-58%);
    z-index: 2;
  }

  .hint {
    position: absolute;
    bottom: -40px; left: 50%;
    transform: translateX(-50%);
    font-family: 'Playfair Display', serif;
    font-style: italic;
    color: #7a4f3a;
    font-size: clamp(12px,3vw,14px);
    letter-spacing: 2px;
    animation: pulse 2s ease-in-out infinite;
    white-space: nowrap;
  }

  @keyframes pulse {
    0%,100%{ opacity:0.4; }
    50%    { opacity:1; }
  }

  /* ─────────────────────────────────────────
     PAGE 2 — SECRET CODE
  ───────────────────────────────────────── */
  #page2 {
    background: #3d0000;
  }

  .bg-img {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .bg-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.25);
    z-index: 1;
  }

  /* Floating strawberries */
  .strawberry {
    position: absolute;
    font-size: 38px;
    z-index: 2;
    pointer-events: none;
    animation: floatBerry ease-in-out infinite;
    filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));
  }

  @keyframes floatBerry {
    0%,100%{ transform: translateY(0) rotate(-5deg); }
    50%    { transform: translateY(-22px) rotate(5deg); }
  }

  .ui {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    width: 100%;
    min-height: 100vh;
  }

  .lock-img {
    width: min(160px, 30vw);
    margin-bottom: 12px;
    animation: lockFloat 3s ease-in-out infinite;
    filter: drop-shadow(0 10px 25px rgba(0,0,0,0.5));
  }

  @keyframes lockFloat {
    0%,100%{ transform: translateY(0); }
    50%    { transform: translateY(-12px); }
  }

  .code-label {
    color: #f5deb3;
    font-size: clamp(15px,4vw,19px);
    letter-spacing: 2px;
    margin-bottom: 6px;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  }

  .divider {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 6px 0 14px;
    color: rgba(201,169,110,0.7);
    font-size: 13px;
  }

  .div-line { width: 65px; height: 1px; background: rgba(201,169,110,0.5); }

  .dots {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
  }

  .dot {
    width: 13px; height: 13px;
    border-radius: 50%;
    border: 1.5px solid rgba(245,222,179,0.7);
    background: transparent;
    transition: all 0.2s;
  }

  .dot.filled {
    background: #f5deb3;
    box-shadow: 0 0 8px rgba(245,222,179,0.6);
  }

  .dot.error {
    border-color: #ff4444;
    background: #ff4444;
    animation: dotShake 0.4s ease;
  }

  @keyframes dotShake {
    0%,100%{transform:translateX(0)}
    25%{transform:translateX(-5px)}
    75%{transform:translateX(5px)}
  }

  .keypad {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    width: min(270px, 78vw);
  }

  .key {
    background: rgba(139,0,0,0.45);
    border: 1px solid rgba(245,222,179,0.25);
    border-radius: 14px;
    color: #f5deb3;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(20px,5vw,26px);
    font-weight: 600;
    padding: clamp(11px,3vw,17px);
    cursor: pointer;
    transition: all 0.15s;
    backdrop-filter: blur(8px);
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .key:hover  { background: rgba(180,0,0,0.55); transform: scale(1.06); }
  .key:active { transform: scale(0.94); }
  .key.zero   { grid-column: 1; }
  .key.del    { grid-column: 2; font-size: clamp(13px,3vw,17px); }

  .err-msg {
    color: #ffaaaa;
    font-size: 14px;
    margin-top: 12px;
    letter-spacing: 1px;
    opacity: 0;
    transition: opacity 0.3s;
    height: 20px;
    text-shadow: 0 1px 6px rgba(0,0,0,0.5);
  }
  .err-msg.show { opacity: 1; }

  /* ─────────────────────────────────────────
     PAGE 3 — INVITATION
  ───────────────────────────────────────── */
  #page3 {
    background: #3d0000;
  }

  .inv-wrap {
    position: relative;
    z-index: 10;
    width: min(92vw, 420px);
    animation: cardIn 1.2s cubic-bezier(0.34,1.56,0.64,1) forwards;
    opacity: 0;
  }

  @keyframes cardIn {
    0%  { opacity:0; transform: scale(0.75) translateY(40px); }
    100%{ opacity:1; transform: scale(1) translateY(0); }
  }

  .inv-wrap img {
    width: 100%;
    display: block;
    border-radius: 16px;
    box-shadow: 0 30px 100px rgba(0,0,0,0.7);
  }

  .sparkle {
    position: absolute;
    pointer-events: none;
    z-index: 5;
    animation: sparkleAnim ease-in-out infinite;
  }

  @keyframes sparkleAnim {
    0%,100%{ transform:translateY(0) rotate(0);   opacity:0.3; }
    50%    { transform:translateY(-15px) rotate(180deg); opacity:0.9; }
  }

  /* ─────────────────────────────────────────
     BURST BERRIES (success)
  ───────────────────────────────────────── */
  .burst {
    position: fixed;
    font-size: 34px;
    z-index: 50;
    pointer-events: none;
    animation: burstAnim 1.2s ease forwards;
  }

  @keyframes burstAnim {
    0%  { transform:translate(0,0) scale(0.5); opacity:1; }
    100%{ transform:translate(var(--dx),var(--dy)) scale(1.8); opacity:0; }
  }

  /* ─────────────────────────────────────────
     TRANSITION OVERLAY
  ───────────────────────────────────────── */
  .trans {
    position: fixed;
    inset: 0;
    background: #8b0000;
    z-index: 200;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
  }
  .trans.show { opacity:1; pointer-events:all; }
</style>
</head>
<body>

<div class="trans" id="trans"></div>

<!-- ══════════════════════════════════
     PAGE 1 — ENVELOPE
══════════════════════════════════ -->
<div class="page active" id="page1">
  <div class="envelope-wrap" id="envWrap" onclick="openEnvelope()">
    <img class="envelope-img" src="envelope.jpeg" alt="Invitation">
    <div class="flap" id="flap">
      <img src="envelope.jpeg" alt="">
    </div>
    <div class="card-peek">🎂 You're Invited!</div>
    <div class="hint">✨ Click to open ✨</div>
  </div>
</div>

<!-- ══════════════════════════════════
     PAGE 2 — SECRET CODE
══════════════════════════════════ -->
<div class="page" id="page2">
  <img class="bg-img" src="background.jpeg" alt="">
  <div class="bg-overlay"></div>

  <!-- Slow floating strawberries -->
  <div class="strawberry" style="left:4%;top:12%;animation-duration:5s;animation-delay:0s;">🍓</div>
  <div class="strawberry" style="left:86%;top:9%;animation-duration:6s;animation-delay:1s;font-size:44px;">🍓</div>
  <div class="strawberry" style="left:5%;top:72%;animation-duration:7s;animation-delay:2s;font-size:34px;">🍓</div>
  <div class="strawberry" style="left:84%;top:68%;animation-duration:5.5s;animation-delay:0.5s;">🍓</div>
  <div class="strawberry" style="left:44%;top:4%;animation-duration:8s;animation-delay:3s;font-size:30px;">🍓</div>
  <div class="strawberry" style="left:50%;top:86%;animation-duration:6.5s;animation-delay:1.5s;font-size:42px;">🍓</div>

  <div class="ui">
    <img class="lock-img" src="background.jpeg" alt="🔒"
         onerror="this.outerHTML='<div style=\'font-size:70px;margin-bottom:12px;\'>🔒</div>'">

    <div class="code-label">Enter the secret code</div>
    <div class="divider">
      <div class="div-line"></div>♥<div class="div-line"></div>
    </div>

    <div class="dots" id="dots">
      <div class="dot" id="d0"></div><div class="dot" id="d1"></div>
      <div class="dot" id="d2"></div><div class="dot" id="d3"></div>
      <div class="dot" id="d4"></div><div class="dot" id="d5"></div>
      <div class="dot" id="d6"></div><div class="dot" id="d7"></div>
    </div>

    <div class="keypad">
      <button class="key" onclick="press('1')">1</button>
      <button class="key" onclick="press('2')">2</button>
      <button class="key" onclick="press('3')">3</button>
      <button class="key" onclick="press('4')">4</button>
      <button class="key" onclick="press('5')">5</button>
      <button class="key" onclick="press('6')">6</button>
      <button class="key" onclick="press('7')">7</button>
      <button class="key" onclick="press('8')">8</button>
      <button class="key" onclick="press('9')">9</button>
      <button class="key zero" onclick="press('0')">0</button>
      <button class="key del"  onclick="del()">⌫</button>
    </div>

    <div class="err-msg" id="errMsg">رمز خاطئ — حاولي مجدداً 🍓</div>
  </div>
</div>

<!-- ══════════════════════════════════
     PAGE 3 — INVITATION
══════════════════════════════════ -->
<div class="page" id="page3">
  <img class="bg-img" src="invitation.jpeg" alt="" style="opacity:0.35;">
  <div class="bg-overlay" style="background:rgba(0,0,0,0.1);"></div>

  <!-- Sparkles -->
  <div class="sparkle" style="left:8%;top:15%;font-size:18px;animation-duration:3s;">✨</div>
  <div class="sparkle" style="left:88%;top:20%;font-size:14px;animation-duration:4s;animation-delay:1s;">🌸</div>
  <div class="sparkle" style="left:15%;top:80%;font-size:16px;animation-duration:5s;animation-delay:2s;">💕</div>
  <div class="sparkle" style="left:80%;top:75%;font-size:20px;animation-duration:3.5s;animation-delay:0.5s;">✨</div>
  <div class="sparkle" style="left:50%;top:8%;font-size:15px;animation-duration:4.5s;animation-delay:1.5s;">🌹</div>

  <div class="inv-wrap" id="invWrap">
    <img src="invitation.jpeg" alt="You're Invited!">
  </div>
</div>

<!-- ══════════════════════════════════
     JAVASCRIPT
══════════════════════════════════ -->
<script>
  /* ── Page switching ── */
  function goTo(pageId) {
    const trans = document.getElementById('trans');
    trans.classList.add('show');
    setTimeout(() => {
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.getElementById(pageId).classList.add('active');
      trans.classList.remove('show');
    }, 650);
  }

  /* ── PAGE 1: Envelope ── */
  let envOpened = false;

  function openEnvelope() {
    if (envOpened) return;
    envOpened = true;
    document.getElementById('envWrap').classList.add('opening');
    document.getElementById('envWrap').onclick = null;
    setTimeout(() => goTo('page2'), 2000);
  }

  /* ── PAGE 2: Code ── */
  const SECRET = '14062005';
  let code = '', locked = false;

  function updateDots() {
    for (let i = 0; i < 8; i++) {
      document.getElementById('d'+i).className = 'dot' + (i < code.length ? ' filled' : '');
    }
  }

  function press(n) {
    if (locked || code.length >= 8) return;
    code += n;
    updateDots();
    if (code.length === 8) setTimeout(checkCode, 250);
  }

  function del() {
    if (locked) return;
    code = code.slice(0, -1);
    updateDots();
    document.getElementById('errMsg').classList.remove('show');
  }

  function checkCode() {
    if (code === SECRET) {
      locked = true;
      successAnim();
    } else {
      for (let i = 0; i < 8; i++) document.getElementById('d'+i).className = 'dot error';
      document.getElementById('errMsg').classList.add('show');
      setTimeout(() => {
        code = '';
        updateDots();
        document.getElementById('errMsg').classList.remove('show');
      }, 1000);
    }
  }

  function successAnim() {
    for (let i = 0; i < 20; i++) {
      const b = document.createElement('div');
      b.className = 'burst';
      b.textContent = '🍓';
      b.style.left = '50vw';
      b.style.top  = '50vh';
      const angle = (i / 20) * 360;
      const dist  = 140 + Math.random() * 180;
      b.style.setProperty('--dx', Math.cos(angle * Math.PI/180) * dist + 'px');
      b.style.setProperty('--dy', Math.sin(angle * Math.PI/180) * dist + 'px');
      b.style.animationDelay = Math.random() * 0.3 + 's';
      document.body.appendChild(b);
      setTimeout(() => b.remove(), 1600);
    }
    setTimeout(() => goTo('page3'), 1400);
  }

  /* Keyboard support */
  document.addEventListener('keydown', e => {
    if (e.key >= '0' && e.key <= '9') press(e.key);
    if (e.key === 'Backspace') del();
  });
</script>
</body>
</html>
